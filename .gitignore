# keep sanitized methodology docs, but not generated corpus evidence,
# raw scan inventories, reviewer notes, or third-party repo results.
docs/field-validation/
field-validation/
corpus-output/
corpus-outputs/
review-notes/
*.field-validation.json
*.field-validation.md
